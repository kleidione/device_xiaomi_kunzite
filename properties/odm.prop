# Audio
ro.vendor.audio.clean_speaker=true
ro.vendor.audio.elus.gyrp.disturbance_avoidance=true
ro.vendor.audio.elus.proximity.cqrcodesupport=true
ro.vendor.audio.elus.proximity.fademodule=true
ro.vendor.audio.elus.proximity.speakermode=true
ro.vendor.audio.feature.adapter=9
ro.vendor.audio.karaoke.enable=true
ro.vendor.audio.onetrack.audio_track_message.level=1
ro.vendor.audio.soundtrigger=sva
ro.vendor.audio.soundtrigger.appdefine.cnn.level=45
ro.vendor.audio.soundtrigger.appdefine.gmm.level=65
ro.vendor.audio.soundtrigger.appdefine.gmm.user.level=55
ro.vendor.audio.soundtrigger.appdefine.vop.level=10
ro.vendor.audio.soundtrigger.lowpower=true
ro.vendor.audio.soundtrigger.pangaea=1
ro.vendor.audio.soundtrigger.snr=6
ro.vendor.audio.soundtrigger.sva-5.0=1
ro.vendor.audio.soundtrigger.training.level=50
ro.vendor.audio.soundtrigger.wakeupword=3
ro.vendor.audio.soundtrigger.xanzn.cnn.level=158
ro.vendor.audio.soundtrigger.xanzn.gmm.level=80
ro.vendor.audio.soundtrigger.xanzn.gmm.user.level=80
ro.vendor.audio.soundtrigger.xanzn.vop.level=10
ro.vendor.audio.soundtrigger.xatx.cnn.level=42
ro.vendor.audio.soundtrigger.xatx.gmm.level=54
ro.vendor.audio.soundtrigger.xatx.gmm.user.level=54
ro.vendor.audio.soundtrigger.xatx.vop.level=0
ro.vendor.audio.soundtrigger.xiaomievent=1
ro.vendor.audio.volume.boost.support=15
vendor.audio.timecheck_timeoutMs=10000

# Display
debug.sf.set_idle_timer_ms=1000
persist.vendor.dc_backlight.enable=false
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.set_touch_timer_ms=500
ro.vendor.cabc.enable=false
ro.vendor.colorpick_adjust=true
ro.vendor.display.all_modes_support_WCG.enable=false
ro.vendor.display.default_fps=60
ro.vendor.display.disable_update_systemUIFlag=true
ro.vendor.display.dolbyvision.support=false
ro.vendor.display.enable_unlock_insert_black_frame=true
ro.vendor.display.fod_monitor_default_fps=120
ro.vendor.display.heartrate_lockfps_support=true
ro.vendor.display.idle_default_fps=60
ro.vendor.display.idle_default_fps.support=false
ro.vendor.display.sensortype=2
ro.vendor.display.set_fps_stat_timer_ms=200
ro.vendor.display.support_iqiyi_10bit=false
ro.vendor.display.svi=1
ro.vendor.display.touch.idle.enable=true
ro.vendor.display.tp_idle_fps=60
ro.vendor.display.type=oled
ro.vendor.display.ultimate.perf.support=true
ro.vendor.display.update_gray_by_temperature=true
ro.vendor.display.video_or_camera_fps.support=true
ro.vendor.fps.switch.default=true
ro.vendor.fps.switch.thermal=true
ro.vendor.hbm_backlight.enable=true
ro.vendor.histogram.enable=true
ro.vendor.mi_sf.hdr_enable_flatmode=false
ro.vendor.mi_sf.highfps_duration_enable=true
ro.vendor.mi_sf.p3_wcg=false
ro.vendor.whitepoint_calibration_enable=false
vendor.display.enable_hist_intr=1
vendor.display.force_tonemapping=1
vendor.display.support_video_mode_30hz_aod=1
vendor.display.svi.config=1
vendor.display.svi.config_path=/odm/etc/SVIConfig.xml

# Radio
persist.vendor.radio.dynamic_sar=1
