hal_client_domain(platform_app, hal_miface)
hal_client_domain(platform_app, hal_aidl_dms)

get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_camera_xiaomi_prop)

allow platform_app vendor_camera_data_file:dir { open read search };
allow platform_app vendor_camera_data_file:file { getattr open read };

dontaudit platform_app vendor_hal_qspmhal_service:service_manager find;
